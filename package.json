{
  "name": "orbe-studio",
  "productName": "Orbe Studio",
  "version": "0.1.0",
  "description": "Orbe Studio — modelagem 3D, animação, VFX/SFX e edição de vídeo com IA (MCP + 50 provedores + modelos locais).",
  "author": "Orbe",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ORBE_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "release": "vite build && electron-builder --win --publish always",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "electron-updater": "^6.3.9",
    "three": "^0.170.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.orbe.app",
    "productName": "Orbe Studio",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "electron/**", "mcp/**", "package.json"],
    "extraResources": [{ "from": "mcp", "to": "mcp" }],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": [{ "provider": "github", "owner": "SEU_USUARIO", "repo": "orbe-studio" }]
  }
}

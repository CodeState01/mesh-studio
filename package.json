{
  "name": "mesh-studio",
  "productName": "Mesh",
  "version": "0.4.0",
  "description": "Mesh — 3D modeling, sculpting, animation, VFX/SFX and video editing with AI (MCP, 70+ providers, local models, or your own Gemini/Claude account).",
  "author": {
    "name": "CodeState01",
    "url": "https://github.com/CodeState01"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env MESH_DEV=1 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && node scripts/build-mcp.mjs && electron-builder --win --publish never",
    "release": "vite build && node scripts/build-mcp.mjs && electron-builder --win --publish always",
    "mcp": "node mcp/server.mjs",
    "build:mcp": "node scripts/build-mcp.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cannon-es": "^0.20.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.3.9",
    "lucide": "^1.70.0",
    "simple-icons": "^16.36.0",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.mesh.app",
    "productName": "Mesh",
    "copyright": "Copyright © 2026 CodeState01 — MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mcp-dist",
        "to": "mcp"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mesh",
      "artifactName": "Mesh-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Mesh-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CodeState01",
        "repo": "mesh-studio",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/CodeState01/mesh-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeState01/mesh-studio.git"
  }
}
